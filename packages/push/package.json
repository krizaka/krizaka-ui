{
  "name": "@krizaka/push",
  "version": "0.2.1",
  "description": "Mobile push without an SDK: the Expo Push Service relays to FCM (Android) and APNs (iOS) from one HTTP call. Pure and dependency-free: batches by 100, never throws, reports the dead tokens to forget.",
  "keywords": [
    "krizaka",
    "push",
    "push-notifications",
    "expo",
    "expo-push",
    "fcm",
    "apns",
    "react-native"
  ],
  "homepage": "https://ui.krizaka.com/packages/push",
  "bugs": "https://github.com/krizaka/krizaka-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-ui.git",
    "directory": "packages/push"
  },
  "license": "Apache-2.0",
  "author": "Krizaka (https://www.krizaka.com)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "size": "size-limit",
    "publint": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@krizaka/config": "workspace:*",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.0",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "name": ".",
      "path": "dist/index.js",
      "limit": "1 kB",
      "gzip": true
    }
  ]
}
