{
  "extends": "@krizaka/config/tsconfig/react-library.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    // The examples of the registry import the primitives as a product does (`@krizaka/ui/button`): resolved to the
    // sources here, in Vitest and in Storybook, so an example never waits for a build.
    "paths": {
      "@krizaka/ui": ["./src/index.ts"],
      "@krizaka/ui/cn": ["./src/cn.ts"],
      "@krizaka/ui/native/*": ["./src/native/*.tsx"],
      "@krizaka/ui/media-player": ["./src/media-gallery/player-index.ts"],
      "@krizaka/ui/media-carousel": ["./src/media-gallery/carousel-index.ts"],
      "@krizaka/ui/pausable-loop": ["./src/media-gallery/loop-index.ts"],
      "@krizaka/ui/*": ["./src/*/index.ts"]
    }
  },
  "include": ["src", "registry/examples/**/*.tsx"]
}
