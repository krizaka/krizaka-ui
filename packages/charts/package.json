      "import": "./dist/chart.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./registry/examples/*": {
      "types": "./registry/examples/*.d.ts",
      "import": "./registry/examples/*.js"
    },
    "./registry/*": "./registry/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "registry/*.json",
    "registry/examples/**/*.tsx",
    "registry/examples/**/*.js",
    "registry/examples/**/*.d.ts",
    "registry/examples/**/*.png",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});for(const f of fs.readdirSync('registry/examples',{recursive:true}))if(/\\.(js|d\\.ts)$/.test(f))fs.rmSync('registry/examples/'+f)\" && tsup && node scripts/build-registry.mjs",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && jest",
    "size": "size-limit",
    "publint": "publint && attw --pack . --profile esm-only && node scripts/consumer.mjs && node scripts/dist-check.mjs",
    "world": "node scripts/world.mjs",
    "prepublishOnly": "pnpm run build"
  },
