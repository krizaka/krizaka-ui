{
  "name": "@krizaka/charts",
  "version": "0.5.0",
  "description": "Krizaka's data visualisation: typed, declarative React charts (line, area, bar, pie, radar, heatmap, calendar, sankey, funnel, gauge, sparkline, candlestick, treemap, scatter, geo map, 3D globe) on the --kz-* tokens and the brand palettes — an accessible data table, a written summary and keyboard navigation in every chart, SSR without layout shift, and React Native for the simple types.",
  "keywords": [
    "krizaka",
    "charts",
    "data-visualization",
    "dataviz",
    "echarts",
    "svg",
    "react",
    "react-native",
    "accessibility",
    "design-system",
    "sparkline",
    "heatmap",
    "sankey",
    "globe"
  ],
  "homepage": "https://ui.krizaka.com",
  "bugs": "https://github.com/krizaka/krizaka-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-ui.git",
    "directory": "packages/charts"
  },
  "license": "Apache-2.0",
  "author": "Krizaka (https://www.krizaka.com)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js"
    },
    "./earnings": {
      "types": "./dist/earnings.d.ts",
      "import": "./dist/earnings.js"
    },
    "./throughput": {
      "types": "./dist/throughput.d.ts",
      "import": "./dist/throughput.js"
    },
    "./latency": {
      "types": "./dist/latency.d.ts",
      "import": "./dist/latency.js"
    },
    "./credits": {
      "types": "./dist/credits.d.ts",
      "import": "./dist/credits.js"
    },
    "./goal": {
      "types": "./dist/goal.d.ts",
      "import": "./dist/goal.js"
    },
    "./ticker": {
      "types": "./dist/ticker.d.ts",
      "import": "./dist/ticker.js"
    },
    "./line": {
      "types": "./dist/line.d.ts",
      "import": "./dist/line.js"
    },
    "./bar": {
      "types": "./dist/bar.d.ts",
      "import": "./dist/bar.js"
    },
    "./pie": {
      "types": "./dist/pie.d.ts",
      "import": "./dist/pie.js"
    },
    "./gauge": {
      "types": "./dist/gauge.d.ts",
      "import": "./dist/gauge.js"
    },
    "./sparkline": {
      "types": "./dist/sparkline.d.ts",
      "import": "./dist/sparkline.js"
    },
    "./geo": {
      "types": "./dist/geo.d.ts",
      "import": "./dist/geo.js"
    },
    "./globe": {
      "types": "./dist/globe.d.ts",
      "import": "./dist/globe.js"
    },
    "./radar": {
      "types": "./dist/radar.d.ts",
      "import": "./dist/radar.js"
    },
    "./heatmap": {
      "types": "./dist/heatmap.d.ts",
      "import": "./dist/heatmap.js"
    },
    "./sankey": {
      "types": "./dist/sankey.d.ts",
      "import": "./dist/sankey.js"
