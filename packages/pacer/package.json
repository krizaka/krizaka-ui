{
  "name": "@krizaka/pacer",
  "version": "0.2.0",
  "description": "Cadence for every Krizaka app: debounce and throttle (functions and React hooks), a job queue with concurrency, priority, retries with backoff, pause and resume per job, and a client rate limiter that learns from a server's Problem Details — TanStack Pacer (beta) behind the Krizaka facade.",
  "keywords": [
    "krizaka",
    "pacer",
    "tanstack-pacer",
    "debounce",
    "throttle",
    "queue",
    "retry",
    "backoff",
    "rate-limit",
    "upload",
    "react-native"
  ],
  "homepage": "https://www.krizaka.com/en/docs/ui",
  "bugs": "https://github.com/krizaka/krizaka-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-ui.git",
    "directory": "packages/pacer"
  },
  "license": "Apache-2.0",
  "author": "Krizaka (https://www.krizaka.com)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "size": "size-limit",
    "publint": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@tanstack/pacer": "0.23.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@krizaka/config": "^0.9.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.39.0",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "name": ".",
      "path": "dist/index.js",
      "limit": "4 kB",
      "gzip": true,
      "ignore": [
        "@tanstack/pacer"
      ]
    },
    {
      "name": "./react",
      "path": "dist/react.js",
      "limit": "2 kB",
      "gzip": true,
      "ignore": [
        "react",
        "@tanstack/pacer"
      ]
    }
  ]
}
