{
  "name": "@krizaka/tokens",
  "version": "3.41.0",
  "description": "The Krizaka semantic design tokens (--kz-*) and the brand themes (Krizaka, Orazaka, Orochia, Yasakia, Yororis, Yomizaka, Kachizaka, Akinaza): one DTCG source compiled to CSS (dark, light, media invariants), typed constants and React Native themes.",
  "keywords": [
    "krizaka",
    "design-tokens",
    "dtcg",
    "css-variables",
    "theme",
    "dark-mode",
    "react-native",
    "design-system",
    "brand",
    "theming"
  ],
  "homepage": "https://ui.krizaka.com/foundations/tokens",
  "bugs": "https://github.com/krizaka/krizaka-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-ui.git",
    "directory": "packages/tokens"
  },
  "license": "Apache-2.0",
  "author": "Krizaka (https://www.krizaka.com)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./brands/krizaka.css": "./dist/brands/krizaka.css",
    "./brands/orazaka.css": "./dist/brands/orazaka.css",
    "./brands/orochia.css": "./dist/brands/orochia.css",
    "./brands/yasakia.css": "./dist/brands/yasakia.css",
    "./brands/yazakia.css": "./dist/brands/yazakia.css",
    "./brands/yororis.css": "./dist/brands/yororis.css",
    "./brands/yomizaka.css": "./dist/brands/yomizaka.css",
    "./brands/kachizaka.css": "./dist/brands/kachizaka.css",
    "./brands/akinaza.css": "./dist/brands/akinaza.css",
    "./brands/scoped.css": "./dist/brands/scoped.css",
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "BRAND.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit",
    "publint": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./tokens.css ./brands/krizaka.css ./brands/orazaka.css ./brands/orochia.css ./brands/yasakia.css ./brands/yazakia.css ./brands/yororis.css ./brands/yomizaka.css ./brands/kachizaka.css ./brands/akinaza.css ./brands/scoped.css",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@krizaka/config": "workspace:*",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "name": "./tokens.css",
      "path": "dist/tokens.css",
      "limit": "4.75 kB",
      "gzip": true,
      "rolldown": false
    },
    {
      "name": "./brands/<id>.css (each)",
      "path": "dist/brands/orazaka.css",
      "limit": "0.8 kB",
      "gzip": true,
      "rolldown": false
    },
    {
      "name": "./brands/scoped.css",
      "path": "dist/brands/scoped.css",
      "limit": "1.5 kB",
      "gzip": true,
      "rolldown": false
    },
    {
      "name": ".",
      "path": "dist/index.js",
      "limit": "4.2 kB",
      "gzip": true
    },
    {
      "name": "./native",
      "path": "dist/native.js",
      "limit": "2.5 kB",
      "gzip": true
    }
  ]
}
