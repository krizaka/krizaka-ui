{
  "$description": "Krizaka — la marque mère. Ink (les surfaces et le texte neutres de la plateforme) et un seul accent, le bleu acier Krizaka du cœur du logo (teinte 208, le complément exact de l'orange d'Orazaka, saturation ≤ 60 % : plus le bleu électrique « IA » — krizaka-ui#393, ADR-003) : il chapeaute les produits sans les concurrencer. Ce sont aussi les valeurs par défaut de tokens.css.",
  "$extensions": {
    "com.krizaka": {
      "mark": [
        ["0%", "hsl(208 46% 45%)"],
        ["100%", "hsl(206 58% 72%)"]
      ]
    }
  },
  "accent": {
    "$type": "color",
    "$root": {
      "$value": "hsl(208 46% 45%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(208 54% 36%)"
        }
      }
    },
    "hover": {
      "$value": "hsl(208 48% 39%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(208 58% 29%)"
        }
      }
    },
    "soft": {
      "$value": "hsl(208 46% 45% / 0.12)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(208 54% 36% / 0.08)"
        }
      }
    },
    "text": {
      "$value": "hsl(206 58% 72%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(208 54% 33%)"
        }
      }
    }
  },
  "accent-2": {
    "$type": "color",
    "$value": "{accent.$root}"
  },
  "on-accent": {
    "$type": "color",
    "$value": "hsl(0 0% 100%)"
  },
  "ring": {
    "$type": "color",
    "$value": "{accent.$root}"
  },
  "info": {
    "$type": "color",
    "$value": "{accent.$root}"
  },
  "info-text": {
    "$type": "color",
    "$value": "{accent.text}"
  },
  "brand-gradient": {
    "$type": "color",
    "from": {
      "$value": "hsl(210 30% 10%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(208 36% 93%)"
        }
      }
    },
    "via": {
      "$value": "hsl(220 14% 7%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(210 30% 97%)"
        }
      }
    },
    "to": {
      "$value": "{surface.0}"
    }
  }
}
