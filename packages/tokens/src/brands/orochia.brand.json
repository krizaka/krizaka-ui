{
  "$description": "Orochia — velours violet → magenta, les couleurs du serpent du logo (inchangé). Les valeurs de @krizaka/orochia-design-system (ajustées AA) : velvet #7c3aed sous texte blanc (5.7:1), magenta #db2777 en second accent (4.6:1), lavande #a78bfa pour le texte et l'anneau sur fond sombre.",
  "accent": {
    "$type": "color",
    "$root": {
      "$value": "hsl(262.1 83.3% 57.8%)"
    },
    "hover": {
      "$value": "hsl(263.4 70% 50.4%)"
    },
    "soft": {
      "$value": "hsl(258.3 89.5% 66.3% / 0.12)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(262.1 83.3% 57.8% / 0.08)"
        }
      }
    },
    "text": {
      "$value": "hsl(255.1 91.7% 76.3%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(263.4 70% 50.4%)"
        }
      }
    }
  },
  "accent-2": {
    "$type": "color",
    "$value": "hsl(333.3 71.4% 50.6%)"
  },
  "on-accent": {
    "$type": "color",
    "$value": "hsl(0 0% 100%)"
  },
  "ring": {
    "$type": "color",
    "$value": "hsl(255.1 91.7% 76.3%)",
    "$extensions": {
      "com.krizaka": {
        "light": "hsl(262.1 83.3% 57.8%)"
      }
    }
  },
  "info": {
    "$type": "color",
    "$value": "{accent.$root}"
  },
  "brand-gradient": {
    "$type": "color",
    "from": {
      "$value": "hsl(266 50% 11%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(262 90% 95%)"
        }
      }
    },
    "via": {
      "$value": "hsl(320 35% 8%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(330 80% 96%)"
        }
      }
    },
    "to": {
      "$value": "hsl(240 6% 5%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(0 0% 98%)"
        }
      }
    }
  }
}