      "$value": "hsl(140 28% 9%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(130 45% 94%)"
        }
      }
    },
    "via": {
      "$value": "hsl(24 20% 8%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(26 60% 95%)"
        }
      }
    },
    "to": {
