{
  "$description": "Akinaza — le vert de la forêt laurentienne et le cuivre chaud. Le vert (130) porte l'accent : ≥ 20° de la sauge de Yororis (98), de l'émeraude de Yasakia (152), du statut succès (160) et de tous les accents (un test). Le cuivre (22) est le second temps (accent-2, le logo) : un métal mat, saturé à moins de 65 % — jamais l'orange vif d'Orazaka (26, 92 %), qu'il ne porte jamais seul. Dark : vert clair sous texte quasi noir ; light : vert profond sous texte blanc. info reste le bleu de Krizaka. Le logo est un dégradé forêt (140) → cuivre (22) de teinte moyenne, ≥ 3:1 sur les surfaces 0–2 des deux thèmes.",
  "$extensions": {
    "com.krizaka": {
      "mark": [
        [
          "0%",
          "hsl(140 48% 34%)"
        ],
        [
          "100%",
          "hsl(22 60% 46%)"
        ]
      ]
    }
  },
  "accent": {
    "$type": "color",
    "$root": {
      "$value": "hsl(130 44% 58%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(132 52% 27%)"
        }
      }
    },
    "hover": {
      "$value": "hsl(130 48% 66%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(132 55% 22%)"
        }
      }
    },
    "soft": {
      "$value": "hsl(130 44% 58% / 0.12)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(132 52% 27% / 0.08)"
        }
      }
    },
    "text": {
      "$value": "hsl(130 50% 66%)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(132 52% 26%)"
        }
      }
    }
  },
  "accent-2": {
    "$type": "color",
    "$value": "hsl(22 62% 64%)",
    "$extensions": {
      "com.krizaka": {
        "light": "hsl(20 62% 36%)"
      }
    }
  },
  "on-accent": {
    "$type": "color",
    "$value": "hsl(140 20% 5%)",
    "$extensions": {
      "com.krizaka": {
        "light": "hsl(0 0% 100%)"
      }
    }
  },
  "ring": {
    "$type": "color",
    "$value": "{accent.$root}"
  },
  "info": {
    "$type": "color",
    "$value": "hsl(207 50% 58%)",
    "$extensions": {
      "com.krizaka": {
        "light": "hsl(208 54% 36%)"
      }
    }
  },
  "info-text": {
    "$type": "color",
    "$value": "hsl(206 58% 72%)",
    "$extensions": {
      "com.krizaka": {
        "light": "hsl(208 54% 33%)"
      }
    }
  },
  "brand-gradient": {
