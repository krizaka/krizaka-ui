{
  "$description": "Surfaces & matières — la signature visuelle Krizaka (BRAND.md §6) : la lumière vient d'en haut. Ce qui se presse s'élève (reflet, arête lumineuse, ombre d'encre), ce qui se remplit se creuse (puits), ce qui flotte est en verre ; l'accent ne s'allume que sur ce qui agit.",
  "surface-sheen": {
    "$type": "color",
    "$value": "hsl(0 0% 100% / 0.045)",
    "$description": "Reflet en haut d'une surface (bg-sheen)",
    "$extensions": {
      "com.krizaka": {
        "light": "hsl(0 0% 100% / 0.7)"
      }
    }
  },
  "fill-shade": {
    "$type": "color",
    "$value": "hsl(0 0% 0% / 0.12)",
    "$description": "Bas d'un aplat (bg-fill-shade), on-accent ≥ 4.5:1"
  },
  "edge": {
    "$type": "color",
    "$description": "Arêtes : un filet intérieur d'1 px",
    "light": {
      "$value": "hsl(0 0% 100% / 0.07)",
      "$description": "Arête lumineuse du haut (inset-shadow-edge)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(0 0% 100% / 0.9)"
        }
      }
    },
    "on-fill": {
      "$value": "hsl(0 0% 100% / 0.22)",
      "$description": "Arête lumineuse sur un aplat"
    },
    "well": {
      "$value": "hsl(240 30% 2% / 0.5)",
