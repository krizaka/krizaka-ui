      "$extensions": {
        "com.krizaka": {
          "light": "hsl(232 25% 25% / 0.08)"
        }
      }
    }
  },
  "glass": {
    "$description": "Verre dépoli de ce qui flotte : 88 %, texte secondaire ≥ 4.5:1 sur tout fond",
