    "0": {
      "$value": "hsl(150 12% 9.5%)",
      "$description": "Fond de page : l'ardoise (sombre), le papier (clair)",
      "$extensions": {
        "com.krizaka": {
          "light": "hsl(100 14% 96%)"
        }
      }
    },
    "1": {
      "$value": "hsl(148 11% 11%)",
      "$description": "Feuille posée : carte, panneau",
