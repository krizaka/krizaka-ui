{
  "font": {
    "$type": "fontFamily",
    "$description": "Typographie — les trois familles de @krizaka/fonts, chacune suivie de son repli aux métriques ajustées",
    "sans": {
      "$value": [
        "Atkinson Hyperlegible Next",
        "Atkinson Hyperlegible Next Fallback",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "sans-serif"
      ],
      "$description": "Texte : interface et lecture (Atkinson Hyperlegible Next)"
    },
    "text": {
      "$value": "{font.sans}",
      "$description": "Alias de sans : le rôle texte"
    },
    "display": {
      "$value": [
        "Young Serif",
        "Young Serif Fallback",
        "Georgia",
        "Times New Roman",
        "serif"
      ],
      "$description": "Affichage : titres, noms, chiffres (Young Serif, une seule graisse) ; surchargé par le thème produit"
    },
    "mono": {
      "$value": [
        "Courier Prime",
        "Courier Prime Fallback",
        "Courier New",
        "ui-monospace",
        "Menlo",
        "Consolas",
        "monospace"
      ],
      "$description": "La machine à écrire : étiquettes, légendes, notes, code (Courier Prime)"
    },
    "accent": {
      "$value": [
        "Caveat Brush",
        "Caveat Brush Fallback",
        "Marker Felt",
        "Bradley Hand",
        "cursive"
      ],
      "$description": "L'ardoise du café : une ligne de menu, une enseigne, un mot (Caveat Brush) ; parcimonieux, jamais du texte courant"
    }
  },
  "type": {
    "$description": "Échelle typographique — taille, interlignage, graisse, approche ; la famille est celle du rôle. Les descriptions des étapes sont en anglais : ui.krizaka.com/foundations/typography les affiche",
    "display-2xl": {
      "$description": "The hero of a home page",
      "$extensions": {
        "com.krizaka": {
          "role": "display"
        }
      },
      "size": {
        "$type": "dimension",
        "$value": "72px"
      },
      "line-height": {
        "$type": "number",
        "$value": 1.11
      },
      "weight": {
        "$type": "fontWeight",
        "$value": 400
      },
      "tracking": {
        "$type": "dimension",
        "$value": "-0.01em"
      }
    },
