{
  "font": {
    "$type": "fontFamily",
    "$description": "Typographie — les trois familles de @krizaka/fonts, chacune suivie de son repli aux métriques ajustées",
    "sans": { "$value": ["Inter", "Inter Fallback", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$description": "Texte : interface et lecture (Inter)" },
    "text": { "$value": "{font.sans}", "$description": "Alias de sans : le rôle texte" },
    "display": { "$value": ["Plus Jakarta Sans", "Plus Jakarta Sans Fallback", "Inter", "system-ui", "sans-serif"], "$description": "Affichage : titres, chiffres (Plus Jakarta Sans) ; surchargé par le thème produit" },
    "mono": { "$value": ["JetBrains Mono", "JetBrains Mono Fallback", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"], "$description": "Code, identifiants, surtitres (JetBrains Mono)" }
  },
  "type": {
    "$description": "Échelle typographique — taille, interlignage, graisse, approche ; la famille est celle du rôle",
    "display-2xl": {
      "$description": "Le héros d'une page d'accueil",
      "$extensions": { "com.krizaka": { "role": "display" } },
      "size": { "$type": "dimension", "$value": "72px" },
      "line-height": { "$type": "number", "$value": 1.02 },
      "weight": { "$type": "fontWeight", "$value": 800 },
      "tracking": { "$type": "dimension", "$value": "-0.035em" }
    },
    "display-xl": {
      "$description": "Le héros d'une page",
      "$extensions": { "com.krizaka": { "role": "display" } },
      "size": { "$type": "dimension", "$value": "56px" },
      "line-height": { "$type": "number", "$value": 1.05 },
      "weight": { "$type": "fontWeight", "$value": 800 },
      "tracking": { "$type": "dimension", "$value": "-0.03em" }
    },
    "display-lg": {
      "$description": "Le titre d'une page",
      "$extensions": { "com.krizaka": { "role": "display" } },
      "size": { "$type": "dimension", "$value": "44px" },
      "line-height": { "$type": "number", "$value": 1.1 },
      "weight": { "$type": "fontWeight", "$value": 700 },
      "tracking": { "$type": "dimension", "$value": "-0.025em" }
    },
    "display-md": {
      "$description": "Le titre d'une section",
      "$extensions": { "com.krizaka": { "role": "display" } },
      "size": { "$type": "dimension", "$value": "34px" },
      "line-height": { "$type": "number", "$value": 1.15 },
      "weight": { "$type": "fontWeight", "$value": 700 },
      "tracking": { "$type": "dimension", "$value": "-0.02em" }
    },
    "display-sm": {
      "$description": "Une sous-section, un grand chiffre",
      "$extensions": { "com.krizaka": { "role": "display" } },
      "size": { "$type": "dimension", "$value": "26px" },
      "line-height": { "$type": "number", "$value": 1.2 },
      "weight": { "$type": "fontWeight", "$value": 700 },
      "tracking": { "$type": "dimension", "$value": "-0.015em" }
    },
    "title-lg": {
      "$description": "Le titre d'une carte, d'un dialogue",
      "$extensions": { "com.krizaka": { "role": "display" } },
      "size": { "$type": "dimension", "$value": "20px" },
      "line-height": { "$type": "number", "$value": 1.35 },
      "weight": { "$type": "fontWeight", "$value": 700 },
      "tracking": { "$type": "dimension", "$value": "-0.01em" }
    },
    "title-md": {
      "$description": "Le titre d'une liste, d'un panneau",
      "$extensions": { "com.krizaka": { "role": "text" } },
      "size": { "$type": "dimension", "$value": "17px" },
      "line-height": { "$type": "number", "$value": 1.4 },
      "weight": { "$type": "fontWeight", "$value": 600 },
      "tracking": { "$type": "dimension", "$value": "-0.012em" }
    },
    "body-lg": {
      "$description": "Le chapeau, un paragraphe mis en avant",
      "$extensions": { "com.krizaka": { "role": "text" } },
      "size": { "$type": "dimension", "$value": "18px" },
      "line-height": { "$type": "number", "$value": 1.6 },
      "weight": { "$type": "fontWeight", "$value": 400 },
      "tracking": { "$type": "dimension", "$value": "-0.014em" }
    },
    "body-md": {
      "$description": "Le texte courant",
      "$extensions": { "com.krizaka": { "role": "text" } },
      "size": { "$type": "dimension", "$value": "16px" },
      "line-height": { "$type": "number", "$value": 1.6 },
      "weight": { "$type": "fontWeight", "$value": 400 },
      "tracking": { "$type": "dimension", "$value": "-0.011em" }
    },
    "body-sm": {
      "$description": "L'interface dense, le texte secondaire",
      "$extensions": { "com.krizaka": { "role": "text" } },
      "size": { "$type": "dimension", "$value": "14px" },
      "line-height": { "$type": "number", "$value": 1.5 },
      "weight": { "$type": "fontWeight", "$value": 400 },
      "tracking": { "$type": "dimension", "$value": "-0.006em" }
    },
    "caption": {
      "$description": "Légendes, aide, métadonnées",
      "$extensions": { "com.krizaka": { "role": "text" } },
      "size": { "$type": "dimension", "$value": "12px" },
      "line-height": { "$type": "number", "$value": 1.4 },
      "weight": { "$type": "fontWeight", "$value": 500 },
      "tracking": { "$type": "dimension", "$value": "0em" }
    },
    "overline": {
      "$description": "Le surtitre d'une section, en capitales",
      "$extensions": { "com.krizaka": { "role": "mono" } },
      "size": { "$type": "dimension", "$value": "11px" },
      "line-height": { "$type": "number", "$value": 1.3 },
      "weight": { "$type": "fontWeight", "$value": 600 },
      "tracking": { "$type": "dimension", "$value": "0.12em" }
    },
    "mono-md": {
      "$description": "Les blocs de code",
      "$extensions": { "com.krizaka": { "role": "mono" } },
      "size": { "$type": "dimension", "$value": "14px" },
      "line-height": { "$type": "number", "$value": 1.6 },
      "weight": { "$type": "fontWeight", "$value": 400 },
      "tracking": { "$type": "dimension", "$value": "0em" }
    },
    "mono-sm": {
      "$description": "Identifiants, points d'accès, versions",
      "$extensions": { "com.krizaka": { "role": "mono" } },
      "size": { "$type": "dimension", "$value": "12px" },
      "line-height": { "$type": "number", "$value": 1.5 },
      "weight": { "$type": "fontWeight", "$value": 400 },
      "tracking": { "$type": "dimension", "$value": "0em" }
    }
  }
}
