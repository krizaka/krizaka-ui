{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build":     { "dependsOn": ["^build"], "outputs": ["dist/**", "tailwind.css", "registry/**", "out/**", ".next/**", "!.next/cache/**", "lib/ui-examples.ts", "lib/ui-example-keys.ts", "lib/ui-registry-data.ts", "lib/release-times.json", "public/ui-examples/**", ".source/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "lint":      { "dependsOn": ["^build"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"] },
    "test":      { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "size":      { "dependsOn": ["build"] },
    "publint":   { "dependsOn": ["build"] },
    "check":     { "dependsOn": ["lint", "typecheck", "test", "build", "size", "publint"] },
    "storybook:build": { "dependsOn": ["^build"], "outputs": ["storybook-static/**"] }
  }
}
