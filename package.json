    "check": "turbo run check",
    "changeset": "changeset",
    "release": "turbo run check && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.7"
  }
