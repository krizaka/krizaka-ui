{
  "name": "krizaka-ui-monorepo",
  "private": true,
  "description": "The Krizaka front-end platform: shared packages published on npm under @krizaka/*.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-ui.git"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint && ast-grep test --skip-snapshot-tests && node scripts/sg-ratchet.mjs && node --test scripts/sg-ratchet.test.mjs",
    "typecheck": "turbo run typecheck",
    "check": "turbo run check",
    "dev:check": "turbo run lint typecheck test --filter='...[origin/main]' --filter='!@krizaka/site' --filter='!@krizaka/storybook'",
    "changeset": "changeset",
    "inventory": "node tools/inventory.mjs",
    "inventory:usage": "node tools/usage-inventory.mjs",
    "inventory:check": "node tools/usage-inventory.mjs --check && node tools/usage-inventory.mjs --budgets",
    "test:tools": "node --test 'tools/**/*.test.mjs'",
    "smoke:consumers": "node tools/consumer-smoke/run.mjs",
    "release": "turbo run check && changeset publish",
    "export:brand": "node tools/export-brand.mjs",
    "lint:sg": "node scripts/sg-ratchet.mjs",
    "lint:sg:test": "ast-grep test --skip-snapshot-tests",
    "sg:ratchet:update": "node scripts/sg-ratchet.mjs --update",
    "sg:fix": "node scripts/sg-fix.mjs"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@krizaka/config": "^0.9.1",
    "eslint": "^9.39.0",
    "sharp": "^0.35.5",
    "turbo": "^2.11.10"
  }
}
