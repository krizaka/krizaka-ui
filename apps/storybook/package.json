{
  "name": "@krizaka/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "The Krizaka platform catalogue: every primitive of @krizaka/ui in dark and light, under each product identity, checked for accessibility and visual regressions.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook:build": "storybook build --quiet",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs && node scripts/test.mjs",
    "test:unit": "node --test scripts/*.test.mjs",
    "test:update": "node scripts/test.mjs --update",
    "test:update:linux": "node scripts/test-linux.mjs"
  },
  "devDependencies": {
    "@krizaka/config": "workspace:*",
    "@krizaka/tailwind": "workspace:*",
    "@krizaka/tokens": "workspace:*",
    "@krizaka/ui": "workspace:*",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-themes": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@storybook/test-runner": "0.26.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/jest": "30.0.0",
    "@types/jest-image-snapshot": "^6.4.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-playwright": "2.2.2",
    "eslint": "^9.39.5",
    "jest-image-snapshot": "6.5.2",
    "playwright": "1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
